# Supabase (Phase 2+) — copy to .env.local; never commit secrets.

NEXT_PUBLIC_SUPABASE_URL=
# Dashboard "Publishable" key (legacy name: anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses RLS; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Optional: apply migrations via npm run db:apply-b1
# Dashboard → Settings → Database → Connection string (URI)
# SUPABASE_DB_URL=

# Deploy (Vercel): set the three vars above in the host dashboard.
# Supabase Auth redirect: https://<your-domain>/auth/callback
# See DEPLOY.md

# Email (Resend) — optional; without RESEND_API_KEY, emails log to server console only
# RESEND_API_KEY=
# EMAIL_FROM=Iturrieta <bookings@your-domain.com>
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# EMAIL_NOTIFICATIONS=true
