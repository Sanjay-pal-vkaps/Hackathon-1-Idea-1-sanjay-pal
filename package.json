{
  "name": "iturrieta-restaurant-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:generate-seed": "tsx scripts/generate-seed-sql.ts",
    "db:apply-b1": "node --env-file=.env.local scripts/apply-supabase-b1.mjs",
    "db:apply-b2-rls": "node --env-file=.env.local scripts/apply-supabase-sql.mjs supabase/migrations/20251027100000_staff_rls.sql",
    "db:apply-i2-customer": "node --env-file=.env.local scripts/apply-supabase-sql.mjs supabase/migrations/20251027300000_customer_auth.sql",
    "db:apply-i4-links": "node --env-file=.env.local scripts/apply-supabase-sql.mjs supabase/migrations/20251027400000_self_service_links.sql",
    "db:apply-seed": "node --env-file=.env.local scripts/apply-supabase-sql.mjs supabase/seed.sql",
    "smoke:local": "node scripts/smoke-local.mjs",
    "staff:create": "node --env-file=.env.local scripts/create-staff-user.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.49.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pg": "^8.13.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^3.0.9"
  }
}
